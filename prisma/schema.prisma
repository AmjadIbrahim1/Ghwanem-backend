// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider         = "postgresql"
  url              = env("DATABASE_URL")
  connection_limit = 5  // مناسب لـ Neon serverless
}

// ═══════════════════════════════════════════════════════════════
// Admin Model - Single Admin Account
// ═══════════════════════════════════════════════════════════════
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ═══════════════════════════════════════════════════════════════
// School Settings - معلومات المدرسة
// ═══════════════════════════════════════════════════════════════
model SchoolSettings {
  id                String   @id @default(uuid())
  schoolName        String   @default("مدرسة الغوانم الاعدادية المشتركة بالحوطا الغربية")
  educationOffice   String   @default("إدارة ديروط التعليمية")
  developerName     String   @default("Eng : Amjad Ibrahim")
  developerPhone    String   @default("+201030615045")
  developerEmail    String   @default("amjadibrahim218@gmail.com")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("school_settings")
}

// ═══════════════════════════════════════════════════════════════
// Academic Year Settings - السنة والفصل الدراسي
// ═══════════════════════════════════════════════════════════════
model AcademicSettings {
  id             String   @id @default(uuid())
  academicYear   String   // e.g., "2024-2025"
  semester       String   // e.g., "الفصل الدراسي الأول"
  grade          String   @default("الصف الثالث الإعدادي") // الصف الدراسي
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  students Student[]
  grades   Grade[]

  @@map("academic_settings")
}

// ═══════════════════════════════════════════════════════════════
// Student Model - بيانات الطالب
// ═══════════════════════════════════════════════════════════════
model Student {
  id                  String   @id @default(uuid())
  seatNumber          String   // رقم الجلوس (unique per academic year)
  name                String
  totalScore          Float    @default(0) // المجموع الكلي
  rank                Int      @default(0) // الترتيب
  academicSettingsId  String
  
  // Metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  academicSettings    AcademicSettings @relation(fields: [academicSettingsId], references: [id], onDelete: Cascade)
  grades              Grade[]

  @@unique([seatNumber, academicSettingsId]) // رقم الجلوس فريد لكل سنة دراسية
  @@index([seatNumber])
  @@index([academicSettingsId])
  @@index([rank])
  @@map("students")
}

// ═══════════════════════════════════════════════════════════════
// Grade Model - درجات الطالب في المواد
// ═══════════════════════════════════════════════════════════════
model Grade {
  id                  String   @id @default(uuid())
  studentId           String
  academicSettingsId  String
  
  // Subject grades - يمكن تخصيص المواد حسب الحاجة
  subject             String   // اسم المادة
  score               Float    // الدرجة
  maxScore            Float    // الدرجة النهائية للمادة
  
  // Metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSettings    AcademicSettings   @relation(fields: [academicSettingsId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, academicSettingsId]) // طالب واحد لكل مادة في كل سنة
  @@index([studentId])
  @@index([academicSettingsId])
  @@map("grades")
}

// ═══════════════════════════════════════════════════════════════
// Excel Upload History - سجل رفع ملفات Excel
// ═══════════════════════════════════════════════════════════════
model ExcelUpload {
  id                  String   @id @default(uuid())
  filename            String
  originalName        String
  fileSize            Int      // بالبايت
  uploadedBy          String   // Admin email
  studentsCount       Int      // عدد الطلاب في الملف
  gradesCount         Int      // عدد الدرجات في الملف
  academicYear        String
  semester            String
  uploadedAt          DateTime @default(now())

  @@map("excel_uploads")
}

// ═══════════════════════════════════════════════════════════════
// System Logs - Optional: لتسجيل العمليات المهمة
// ═══════════════════════════════════════════════════════════════
model SystemLog {
  id          String   @id @default(uuid())
  action      String   // e.g., "LOGIN", "UPLOAD_EXCEL", "UPDATE_SETTINGS"
  performedBy String   // Admin email
  details     String?  // JSON string with additional info
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([performedBy])
  @@index([createdAt])
  @@map("system_logs")
}